# Microsoft Foundry Project Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# AZURE CONFIGURATION
# ============================================================================
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_RESOURCE_GROUP=your-resource-group-here
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_KEY=your-storage-key-here
AZURE_LOCATION=eastus

# ============================================================================
# FOUNDRY CONFIGURATION
# ============================================================================
FOUNDRY_API_KEY=your-foundry-api-key-here
FOUNDRY_WORKSPACE=your-workspace-name
FOUNDRY_REALM=us
ENDPOINT=https://your-resource-name-0503-resource.services.ai.azure.com/api/projects/your-project-name

# ============================================================================
# SPARK CONFIGURATION
# ============================================================================
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SQL_SHUFFLE_PARTITIONS=200

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=False

# ============================================================================
# DATA PATHS
# ============================================================================
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
CHECKPOINT_PATH=./checkpoints

# ============================================================================
# PIPELINE SETTINGS
# ============================================================================
BATCH_SIZE=1000
MAX_RETRIES=3
RETRY_DELAY=5
TIMEOUT=3600
